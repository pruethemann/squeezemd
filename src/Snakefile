import sys
import numpy as np
import pandas as pd
import yaml
from os import path
from Helper import save_yaml

# ======================
# Configuration Handling
# ======================

# Import the simulation and Molecular dynamics parameters
configfile: path.join('config', 'sim_config.yml') 
with open(path.join('config', 'md_config.yml')) as f:
    config_md = yaml.safe_load(f)
# merge both configs together
config.update(config_md)

COMPLEXES = list(config.get("complexes").keys())
mutations = config['mutations']
n_frames = config['simulation']['number_frames']

# ==================================
# Random Seed Generation for Replicates
# ==================================
seed = config.get("seed", 23)
np.random.seed(seed)  # Ensure reproducibility
seeds = np.random.randint(100, 1000, size=config['simulation']['replicates'])
representative_seed = seeds[0] # First seeds is used as representation for surface interaction analysis

try:
    mode = [arg for arg in sys.argv[1:] if not arg.startswith("-")][1]
except:
    mode = 'PPi'

# TODO: Check whether metadynamics settings are enabled.

# Run a protein-protein interaction analysis
rule PPi:
    input:
        'results/alignment/align.pse',
        'results/metaReport.html',
        expand('{mode}/{complex}/{mutation}/{seed}/fingerprint/fingerprint.parquet',complex=COMPLEXES,mutation=mutations,seed=seeds,mode=mode),
        'results/posco/lig_heatmap.svg',
        'results/posco/lig_barplot.svg',
        'results/rmsf/rmsf.svg',
        expand('results/interactionSurface/{complex}.{mutation}.interaction.pdb', complex=COMPLEXES, mutation=mutations),

rule metadynamics:
    input:
        expand('metadynamics/{complex}/{mutation}/{seed}/metadynamics/fes.dat',complex=COMPLEXES, mutation=mutations, seed=seeds),
        expand('metadynamics/{complex}/{mutation}/{seed}/metadynamics/freeenergy.png',complex=COMPLEXES, mutation=mutations, seed=seeds),
        'results/alignment/align.pse',
        'results/metaReport.html',
        expand('metadynamics/{complex}/{mutation}/{seed}/fingerprint/fingerprint.parquet',complex=COMPLEXES,mutation=mutations,seed=seeds),
        'results/posco/lig_heatmap.svg',
        'results/posco/lig_barplot.svg',
        'results/rmsf/rmsf.svg',
        expand('results/interactionSurface/{complex}.{mutation}.interaction.pdb', complex=COMPLEXES, mutation=mutations),

rule molecule:
    input:
        'results/metaReport.html',
        expand('molecule/{complex}/{mutation}/{seed}/frames/lig_{i}.pdb', i=range(n_frames), complex=COMPLEXES, mutation=mutations, seed=seeds),
        expand('molecule/{complex}/{mutation}/{seed}/frames/rec_{i}.pdb', i=range(n_frames), complex=COMPLEXES, mutation=mutations, seed=seeds),
        expand('molecule/{complex}/{mutation}/{seed}/po-sco/{i}.txt', i=range(n_frames), complex=COMPLEXES, mutation=mutations, seed=seeds),
        #'results/posco/posco_interactions.parquet',
        #'results/alignment/align.pse'
        #expand('molecule/{complex}/{mutation}/{seed}/aquaduct/aquaduct.pse',complex=COMPLEXES, mutation=mutations, seed=seeds)

# Run a apo protein only
rule protein:
    input:
        expand('{complex}/{mutation}/{seed}/MD/traj_center.dcd', complex=COMPLEXES, mutation=mutations, seed=seeds),
        expand('{complex}/{mutation}/{seed}/analysis/RMSF.html', complex=COMPLEXES, mutation=mutations, seed=seeds),
        expand('{complex}/{mutation}/{seed}/aquaduct/aquaduct.pse',complex=COMPLEXES, mutation=mutations, seed=seeds)

rule metaReport:
    input:
        md_config='config/md_config.yml',
        sim_config='config/sim_config.yml'
    output:
        report('results/metaReport.html',caption="RMSF.rst",category="Meta")
    shell:
        """
        metaReport.py  --param {input.md_config} \
                       --sims {input.sim_config} \
                       --output {output}
        """

rule Mutagensis:
    input:
        'config/md_config.yml',
        'config/sim_config.yml'
    output:
        '{mode}/{complex}/{mutation}/mutation.pdb'
    params:
        out_dir=directory('{mode}/{complex}/{mutation}'),
        foldX='foldx_20251231',
        pdb=lambda wc: config["complexes"][wc.complex]["pdb"]
    log:
        '{mode}/{complex}/{mutation}/mutation.log'
    shell:
        """
        if [[ {wildcards.mutation} = WT ]]
        then    # No mutagenisis
            cp {params.pdb} {output}
        else    # Mutate
            1_mutation.py --mutation {wildcards.mutation} --ligand {params.pdb} --output {wildcards.mode}/{wildcards.complex}/{wildcards.mutation}/mutant_file.txt
            cp {params.pdb} {params.out_dir}/WT.pdb
            {params.foldX} --command=BuildModel --pdb-dir="{params.out_dir}" --pdb=WT.pdb --mutant-file={wildcards.mode}/{wildcards.complex}/{wildcards.mutation}/mutant_file.txt --output-dir="{params.out_dir}" --rotabaseLocation ~/tools/foldx/rotabase.txt > {log} || true
            mv {params.out_dir}/WT_1.pdb {output}
        fi
        """

rule MD_PPi:
    input:   
        md_settings=ancient('config/md_config.yml'),
        pdb='PPi/{complex}/{mutation}/mutation.pdb',
    output:
        equilibrated='PPi/{complex}/{mutation}/{seed}/MD/equilibrated.pdb',
        topo_cif='PPi/{complex}/{mutation}/{seed}/MD/frame_end.cif',
        traj=temp('PPi/{complex}/{mutation}/{seed}/MD/trajectory.h5'),
        stats='PPi/{complex}/{mutation}/{seed}/MD/MDStats.csv'
    resources: gpu=1
    priority: 3
    shell:
        """
        2_MD.py --pdb {input.pdb} \
                --equilibrated {output.equilibrated} \
                --topo_cif {output.topo_cif} \
                --traj {output.traj} \
                --md_settings {input.md_settings} \
                --seed {wildcards.seed} \
                --stats {output.stats}
        """

rule MD_molecule:
    input:   
        md_settings=ancient('config/md_config.yml'),
        pdb='molecule/{complex}/{mutation}/mutation.pdb',
        sdf=lambda wc: config["complexes"][wc.complex]["sdf"]
    output:
        equilibrated='molecule/{complex}/{mutation}/{seed}/MD/equilibrated.pdb',
        topo_cif='molecule/{complex}/{mutation}/{seed}/MD/frame_end.cif',
        traj=temp('molecule/{complex}/{mutation}/{seed}/MD/trajectory.h5'),
        stats='molecule/{complex}/{mutation}/{seed}/MD/MDStats.csv',
    resources: gpu=1
    priority: 3
    shell:
        """
        2_MD.py --pdb {input.pdb} \
                --equilibrated {output.equilibrated} \
                --topo_cif {output.topo_cif} \
                --traj {output.traj} \
                --md_settings {input.md_settings} \
                --seed {wildcards.seed} \
                --stats {output.stats} \
                --sdf {input.sdf}
        """

rule MD_metadynamics:
    input:   
        md_settings=ancient('config/md_config.yml'),
        pdb='metadynamics/{complex}/{mutation}/mutation.pdb',
    output:
        equilibrated = 'metadynamics/{complex}/{mutation}/{seed}/MD/equilibrated.pdb',
        topo_cif = 'metadynamics/{complex}/{mutation}/{seed}/MD/frame_end.cif',
        traj=temp('metadynamics/{complex}/{mutation}/{seed}/MD/trajectory.h5'),
        stats='metadynamics/{complex}/{mutation}/{seed}/MD/MDStats.csv',
        metadynamics_hill='metadynamics/{complex}/{mutation}/{seed}/metadynamics/metadynamics_hill.txt',
        metadynamics_colvar='metadynamics/{complex}/{mutation}/{seed}/metadynamics/Colvar.dat'
    resources: gpu=1
    priority: 3
    shell:
        """
        2_MD.py --pdb {input.pdb} \
                --equilibrated {output.equilibrated} \
                --topo_cif {output.topo_cif} \
                --traj {output.traj} \
                --md_settings {input.md_settings} \
                --seed {wildcards.seed} \
                --stats {output.stats} \
                --metadynamics_hill {output.metadynamics_hill} \
                --metadynamics_colvar {output.metadynamics_colvar}
        """

rule compute_metadynamics:
    input:   
        'metadynamics/{complex}/{mutation}/{seed}/metadynamics/metadynamics_hill.txt'
    output:
        'metadynamics/{complex}/{mutation}/{seed}/metadynamics/fes.dat'
    shell:
        """
        plumed sum_hills --hills {input} --outfile {output}
        """

rule metadynamics_ana:
    input:
        fes='metadynamics/{complex}/{mutation}/{seed}/metadynamics/fes.dat',
        colvar='metadynamics/{complex}/{mutation}/{seed}/metadynamics/Colvar.dat',
    output:
        freeenergy='metadynamics/{complex}/{mutation}/{seed}/metadynamics/freeenergy.png',
        colvar_fig='metadynamics/{complex}/{mutation}/{seed}/metadynamics/colvar.png',
    shell:
        """
        14.1_Metadynamics_Colvar_ana.py --colvar {input.colvar} --colvar_fig {output.colvar_fig} &&
        14.2_Metadynamics_Hills_ana.py --fes {input.fes} --freeenergy {output.freeenergy}
        """

rule centerMDTraj:
    input:
        topo='{mode}/{complex}/{mutation}/{seed}/MD/frame_end.cif',
        traj='{mode}/{complex}/{mutation}/{seed}/MD/trajectory.h5'
    output:
        topo_center='{mode}/{complex}/{mutation}/{seed}/MD/topo_center_{seed}.pdb',
        traj_center='{mode}/{complex}/{mutation}/{seed}/MD/traj_center.dcd'
    priority: 3
    shell:
        """
        4_centerMDTraj.py   --topo {input.topo} \
                            --traj {input.traj} \
                            --traj_center {output.traj_center} \
                            --topo_center {output.topo_center}
        """

rule align:
    input:
        expand('{mode}/{complex}/{mutation}/{seed}/MD/topo_center_{seed}.pdb',complex=COMPLEXES, mutation=mutations, seed=seeds, mode=mode),
    output:
        'results/alignment/align.pse'
    params: os.path.join(os.environ['CONDA_PREFIX'], 'bin', '6_Align.py')
    shell:
        "pymol -c {params} --input {input} --output {output}"

rule aquaduct:
    input:
        topo_center = '{mode}/{complex}/{mutation}/{seed}/MD/topo_center_{seed}.pdb',
        traj_center='{mode}/{complex}/{mutation}/{seed}/MD/traj_center.dcd',
        aquaduct_template='config/TEMPLATE_aquaduct.txt',
    output:
        aquaduct='{mode}/{complex}/{mutation}/{seed}/aquaduct/aquaduct.txt',
        aquaduct_folder=directory('{mode}/{complex}/{mutation}/{seed}/aquaduct/'),
        pymol_cmd='{mode}/{complex}/{mutation}/{seed}/aquaduct/6_visualize_results.py',
    priority:
        10
    params:
        directory('{mode}/{complex}/{mutation}/{seed}')
    conda:
        "aquaduct"
    shell:
        """
        sed  's|PREFIXINPUT|{params}|g' {input.aquaduct_template} > {output.aquaduct} &&
        sed  -i 's|PREFIXOUT|{output.aquaduct_folder}|g' {output.aquaduct} &&
        valve_run -c {output.aquaduct}
        """

rule aquaductPymol:
    input:
        '{mode}/{complex}/{mutation}/{seed}/aquaduct/6_visualize_results.py',
    output:
        '{mode}/{complex}/{mutation}/{seed}/aquaduct/aquaduct.pse',
    priority:
        10
    params:
        directory('{complex}/{mutation}/{seed}')
    shell:
        """
        python3 {input} --save-session {output}
        """

rule DescriptiveTrajAnalysis:
    input:
        topo='{mode}/{complex}/{mutation}/{seed}/MD/frame_end.cif',
        traj='{mode}/{complex}/{mutation}/{seed}/MD/traj_center.dcd',
        stats='{mode}/{complex}/{mutation}/{seed}/MD/MDStats.csv'
    output:
        rmsf= report('{mode}/{complex}/{mutation}/{seed}/analysis/RMSF.html',caption="RMSF.rst",category="RMSF",labels={"Complex": "{complex}", "Mutation": "{mutation}"}),
        rmsd= report('{mode}/{complex}/{mutation}/{seed}/analysis/RMSD.svg',caption="RMSF.rst",category="RMSD",labels={"Complex": "{complex}", "Mutation": "{mutation}"}),
        rmsd_raw= '{mode}/{complex}/{mutation}/{seed}/analysis/RMSD.csv',
        bfactors='{mode}/{complex}/{mutation}/{seed}/analysis/bfactors.pdb',
        stats='{mode}/{complex}/{mutation}/{seed}/analysis/Stats.svg',
    params:
        number_frames = n_frames
    shell:
        """
        3.1_ExplorativeTrajectoryAnalysis.py --topo {input.topo} \
                                                   --traj {input.traj} \
                                                   --stats {input.stats} \
                                                   --rmsf {output.rmsf} \
                                                   --bfactors {output.bfactors} \
                                                   --rmsd {output.rmsd} \
                                                   --rmsd_raw {output.rmsd_raw} \
                                                   --fig_stats {output.stats}
        """

rule calculateRMSF:
    input:
        topo = expand('{mode}/{complex}/{mutation}/{seed}/MD/frame_end.cif',complex=COMPLEXES, mutation=mutations, seed=seeds, mode=mode),
        traj = expand('{mode}/{complex}/{mutation}/{seed}/MD/traj_center.dcd',  complex=COMPLEXES, mutation=mutations, seed=seeds, mode=mode), 
    output:
        'results/rmsf/rmsf.parquet'
    shell:
        """
        3.2_Compute_RMSF.py --topo {input.topo} \
                            --traj {input.traj} \
                            --output {output}
        """

rule visualiseRMSF:
    input:
        'results/rmsf/rmsf.parquet'
    output:
        'results/rmsf/rmsf.svg'
    shell:
        """
        3.3_Visualize_RMSF.py --input {input} \
                              --output {output}
        """

rule ExtractFrames:
    input:
        topo='{mode}/{complex}/{mutation}/{seed}/MD/frame_end.cif',
        traj='{mode}/{complex}/{mutation}/{seed}/MD/traj_center.dcd'
    output:
        lig_frame='{mode}/{complex}/{mutation}/{seed}/frames/lig_{i}.pdb',
        rec_frame='{mode}/{complex}/{mutation}/{seed}/frames/rec_{i}.pdb'
    params:
        sequence='{mode}/{complex}/{mutation}/{seed}/frames/sequence.parquet'
    shell:
        """
        5.1_Posco_ExtractLastFrames.py  --topo {input.topo} \
                                        --traj {input.traj} \
                                        --frame {wildcards.i} \
                                        --lig_frame {output.lig_frame} \
                                        --rec_frame {output.rec_frame} \
                                        --sequence {params.sequence}
        """

rule posco:
    input:
        lig_frame='{mode}/{complex}/{mutation}/{seed}/frames/lig_{i}.pdb',
        rec_frame='{mode}/{complex}/{mutation}/{seed}/frames/rec_{i}.pdb'
    output:
        '{mode}/{complex}/{mutation}/{seed}/po-sco/{i}.txt'
    threads: 1
    shell:
        """
        po-sco {input.rec_frame} {input.lig_frame} -b  > {output}
        """

# PosCo
rule concatPosco:
    input:
        posco = expand('{mode}/{complex}/{mutation}/{seed}/po-sco/{i}.txt', i=range(n_frames), complex=COMPLEXES, mutation=mutations, seed=seeds, mode= mode),
    output:
        'results/posco/posco_interactions.parquet'
    shell:
        """5.2_Posco_TransformDF.py --input {input.posco} --output {output}"""


# PosCo
rule PoScoHeatMap:
    input:
        data='results/posco/posco_interactions.parquet'
    output:
        lig_heatmap='results/posco/lig_heatmap.svg',
        rec_heatmap='results/posco/rec_heatmap.svg',
    shell:
        """
        5.4_Posco_Heatmap.py --input {input.data} --ligand_interaction {output.lig_heatmap} --receptor_interaction {output.rec_heatmap}
        """

