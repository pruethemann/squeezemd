rule prep_mutagenesis:
    input:
        md_config,
        'config/sim_config.yaml'
    output:
        '{mode}/{complex}/{mutation}/mutation.pdb'
    params:
        out_dir=directory('{mode}/{complex}/{mutation}'),
        foldX='foldx_20261231',
        pdb=lambda wc: config["complexes"][wc.complex]["pdb"]
    log:
        '{mode}/{complex}/{mutation}/mutation.log'
    shell:
        """
        if [[ {wildcards.mutation} = WT ]]
        then    # No mutagenesis
            cp {params.pdb} {output}
        else    # Mutate
            mutate --mutation {wildcards.mutation} --ligand {params.pdb} --output {wildcards.mode}/{wildcards.complex}/{wildcards.mutation}/mutant_file.txt
            cp {params.pdb} {params.out_dir}/WT.pdb
            {params.foldX} --command=BuildModel --pdb-dir="{params.out_dir}" --pdb=WT.pdb --mutant-file={wildcards.mode}/{wildcards.complex}/{wildcards.mutation}/mutant_file.txt --output-dir="{params.out_dir}" --rotabaseLocation ~/tools/foldX/foldx_Linux/rotabase.txt > {log} || true
            mv {params.out_dir}/WT_1.pdb {output}
        fi
        """

